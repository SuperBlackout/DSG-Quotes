{
  "name": "app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm prisma:generate && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "dev": "react-router dev",
    "prisma:generate": "prisma generate --schema ../apps/api/prisma/schema.prisma",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "shared": "workspace:*",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@shopify/app-bridge-types": "0.7.2",
    "@shopify/polaris-types": "1.0.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^2.1.0"
  }
}
