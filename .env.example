# Copy to .env for local dev. Never commit real values. Dev store only (CLAUDE.md rule 8).
NODE_ENV=development
DATABASE_URL=postgresql://dsg_quotes:dsg_quotes@localhost:5432/dsg_quotes

# Shopify (Dev Dashboard app credentials; `shopify app dev` also injects these)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_customers,read_companies,read_products,read_inventory,read_orders,read_draft_orders,write_draft_orders
SHOP_DOMAIN=your-dev-store.myshopify.com
SESSION_SECRET=change-me-32-chars-minimum-random

# Customer-facing links in email/SMS
APP_PUBLIC_URL=https://your-dev-store.myshopify.com/apps/quotes

# Email (Postmark)
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_TOKEN=
EMAIL_FROM=quotes@dsg.direct
EMAIL_REPLY_DOMAIN=reply.dsg.direct
# HMAC secret for the Reply-To tokens; must be the same on web and worker (falls back to SHOPIFY_API_SECRET)
REPLY_TOKEN_SECRET=
# Where alerts go when a quote has no active rep, no team members and the shop has no manager/admin
SALES_NOTIFY_EMAIL=
# Staff links in alerts: ${ADMIN_QUOTE_URL}/<quoteId> (default https://<SHOP_DOMAIN>/admin/apps/dsg-quotes/quotes)
ADMIN_QUOTE_URL=
# Shown in the weekly summary / HELP reply
SUPPORT_EMAIL=quotes@dsg.direct
SUPPORT_PHONE=

# SMS (Twilio, A2P 10DLC Messaging Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Exact public URL Twilio posts inbound texts to, if a proxy changes the URL the API sees (signature check uses it)
TWILIO_WEBHOOK_URL=

# Worker
# Event queue poll interval (ms)
WORKER_POLL_MS=5000

# Attachments (S3 compatible)
ATTACHMENTS_BUCKET=
ATTACHMENTS_REGION=us-east-1
ATTACHMENTS_S3_ENDPOINT=
# Public (or CDN) base used to build Attachment.url / UploadUrl.fileUrl, no trailing slash
ATTACHMENTS_PUBLIC_BASE_URL=
ATTACHMENTS_ACCESS_KEY_ID=
ATTACHMENTS_SECRET_ACCESS_KEY=

# Quote behavior
# Days added to "now" for expiresAt when a rep sends without choosing an expiry
QUOTE_DEFAULT_EXPIRY_DAYS=14
# Reject app proxy requests whose signed `timestamp` is older than this (replay protection)
SIGNATURE_MAX_AGE_SECONDS=300

SENTRY_DSN=

# Account pages: Statement + Account info (read-only Zoho Books). Leave the four ZOHO_* credentials empty to keep them off.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Defaults are the US data centre; set both for EU/IN
ZOHO_API_BASE=
ZOHO_ACCOUNTS_BASE=
# Where the customer number lives on a Zoho contact (top-level key, or a custom-field label / api_name / cf_* key)
ZOHO_CUSTOMER_NUMBER_FIELD=contact_number
# HMAC secret for POST /webhooks/zoho (empty: webhooks rejected, the nightly sync still refreshes everything)
ZOHO_WEBHOOK_SECRET=
# Origin used in PDF download links (defaults to SHOPIFY_APP_URL)
STATEMENT_PUBLIC_BASE_URL=
# Debounce for webhook-triggered syncs, ms
SYNC_DEBOUNCE_MS=30000
