// DSG Quotes Prisma schema. Owned by the backend agent.
//
// engineType "client" = Rust-free query compiler + driver adapter (@prisma/adapter-pg). Chosen so the
// build needs no engine binary downloads. Migrations in ./migrations are hand-maintained SQL kept in
// sync with this file; test/schema-sync.test.ts fails if a model field has no matching column.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  QUOTE_READY
  CHANGES_REQUESTED
  ACCEPTED
  ORDERED
  EXPIRED
  DECLINED
  ARCHIVED
}

enum AuthorType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum Channel {
  WEB
  EMAIL
  SMS
}

enum StaffRole {
  rep
  manager
  admin
}

// Which collection a QuoteLine belongs to.
//  CUSTOMER = the customer's own lines (draft, and the request as submitted). Never repriced by staff.
//  STAFF    = the rep's editable working revision (draft-revision). Invisible to customers.
//  VERSION  = frozen lines of a sent QuoteVersion (versionId set).
enum LineSet {
  CUSTOMER
  STAFF
  VERSION
}

// Shopify session storage for the app template
model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
  // Fields @shopify/shopify-app-session-storage-prisma writes for online (per-staff) sessions.
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean?
  locale              String?
  collaborator        Boolean?
  emailVerified       Boolean?
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Job {
  id                String   @id @default(cuid())
  shop              String
  companyId         String // gid://shopify/Company/...
  companyLocationId String? // gid://shopify/CompanyLocation/...
  name              String
  poNumber          String?
  siteAddress       String?
  createdById       String // gid://shopify/Customer/...
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  quotes            Quote[]

  @@index([shop, companyId])
  @@index([shop, companyLocationId])
}

model Quote {
  id                  String         @id @default(cuid())
  shop                String
  number              Int // displayed as Q-10482; unique per shop
  jobId               String?
  job                 Job?           @relation(fields: [jobId], references: [id])
  title               String
  customerId          String // owner (gid)
  customerName        String         @default("")
  customerEmail       String?
  companyId           String?
  companyName         String?
  companyLocationId   String?
  assignedRepId       String?
  assignedRep         Staff?         @relation(fields: [assignedRepId], references: [id])
  teamId              String?
  createdByStaffId    String?
  status              QuoteStatus    @default(DRAFT)
  statusChangedAt     DateTime       @default(now())
  currentVersion      Int            @default(0) // 0 = never sent, 1..n = sent revisions
  poNumber            String?
  notesToSales        String?
  neededBy            DateTime?
  shipToAddress       Json?
  expiresAt           DateTime?
  currencyCode        String         @default("USD") // ISO 4217, snapshotted from the shop at creation
  paymentTerms        String? // company payment terms name from Shopify (read only), e.g. "Net 30"
  customerContactPhone String?
  // Derived, refreshed whenever lines change (see domain/derived.ts)
  total               Decimal        @default(0) @db.Decimal(12, 2) // customer-visible total
  lineCount           Int            @default(0)
  marginPct           Decimal?       @db.Decimal(7, 2) // staff working set
  belowFloor          Boolean        @default(false)
  // Staff working revision header (not visible to the customer)
  workingFreight      Decimal        @default(0) @db.Decimal(12, 2)
  workingExpiresAt    DateTime?
  workingRepNote      String?
  workingInternalNote String?
  // Accept -> buy
  draftOrderId        String? // set on checkout; cleared on reopen
  draftOrderInvoiceUrl String?
  draftOrderVersion   Int? // currentVersion the draft order was built from
  draftOrderStatus    String? // last status seen from draft_orders/update
  orderId             String? // set by orders/create webhook
  watchers            Json           @default("[]") // extra people to notify
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  versions            QuoteVersion[]
  lines               QuoteLine[]
  messages            Message[]
  events              Event[]

  @@unique([shop, number])
  @@index([shop, companyLocationId, status])
  @@index([shop, companyId, status])
  @@index([shop, assignedRepId, status])
  @@index([shop, status, updatedAt])
}

model QuoteVersion {
  id            String      @id @default(cuid())
  quoteId       String
  quote         Quote       @relation(fields: [quoteId], references: [id])
  versionNo     Int
  sentById      String?
  sentAt        DateTime    @default(now())
  subtotal      Decimal     @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @db.Decimal(12, 2)
  freight       Decimal     @default(0) @db.Decimal(12, 2)
  taxEstimate   Decimal?    @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  repNote       String? // customer-visible job notes
  internalNote  String? // staff only
  lines         QuoteLine[]

  @@unique([quoteId, versionNo])
}

model QuoteLine {
  id            String        @id @default(cuid())
  quoteId       String
  quote         Quote         @relation(fields: [quoteId], references: [id])
  versionId     String? // set only for set = VERSION
  version       QuoteVersion? @relation(fields: [versionId], references: [id])
  set           LineSet       @default(CUSTOMER)
  variantId     String // gid://shopify/ProductVariant/...
  sku           String?
  title         String
  imageUrl      String?
  qty           Int
  listPrice     Decimal       @db.Decimal(12, 2) // dealer/catalog price snapshot
  quotedPrice   Decimal       @db.Decimal(12, 2)
  cost          Decimal?      @db.Decimal(12, 2) // STAFF ONLY: never serialize to customers
  lineNote      String?
  floorApproved Boolean       @default(false)
  floorApprovedById String?
  addedBy       AuthorType    @default(CUSTOMER)
  position      Int

  @@index([quoteId, set])
  @@index([versionId])
}

model Message {
  id          String     @id @default(cuid())
  quoteId     String
  quote       Quote      @relation(fields: [quoteId], references: [id])
  authorType  AuthorType
  authorId    String?
  authorName  String?
  body        String
  internal    Boolean    @default(false) // staff-only note
  attachments Json       @default("[]") // [{url, name, size, mime}]
  channel     Channel    @default(WEB)
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([quoteId, createdAt])
}

model NotificationPref {
  id             String    @id @default(cuid())
  shop           String
  customerId     String?
  staffId        String?
  event          String // e.g. QUOTE_READY, NEW_MESSAGE, EXPIRING
  email          Boolean   @default(true)
  sms            Boolean   @default(false)
  phone          String?
  smsOptInAt     DateTime?
  smsConsentText String? // exact consent copy shown at opt-in
  quietStart     String? // "19:00"
  quietEnd       String? // "07:00"
  timezone       String    @default("America/New_York")

  @@unique([shop, customerId, staffId, event])
  @@index([shop, customerId])
}

// Per-customer contact settings that are not per-event (notification email, extra watchers).
model CustomerProfile {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  email      String?
  watchers   Json     @default("[]")
  updatedAt  DateTime @updatedAt

  @@unique([shop, customerId])
}

// Which draft "Add to Quote" targets, per customer.
model ActiveQuote {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  quoteId    String
  updatedAt  DateTime @updatedAt

  @@unique([shop, customerId])
}

// Monotonic per-shop counters (quote numbers).
model Counter {
  shop  String
  key   String
  value Int    @default(0)

  @@id([shop, key])
}

// Dedupe for Shopify webhook redelivery (X-Shopify-Webhook-Id).
model WebhookReceipt {
  id         String   @id // X-Shopify-Webhook-Id
  topic      String
  receivedAt DateTime @default(now())
}

model Event {
  id         String     @id @default(cuid())
  quoteId    String
  quote      Quote      @relation(fields: [quoteId], references: [id])
  type       String // QuoteEvent or NEW_MESSAGE
  actorType  AuthorType
  actorId    String?
  payload    Json       @default("{}")
  notifiedAt DateTime? // set by worker once fanned out
  createdAt  DateTime   @default(now())

  @@index([notifiedAt, createdAt])
  @@index([quoteId, createdAt])
}

model Staff {
  id             String       @id @default(cuid())
  shop           String
  shopifyStaffId String?
  name           String
  email          String
  phone          String?
  role           StaffRole    @default(rep)
  active         Boolean      @default(true)
  priceFloorPct  Decimal?     @db.Decimal(5, 2) // personal override; null = use ShopSetting.defaultPriceFloorPct
  quotes         Quote[]
  teams          TeamMember[]

  @@unique([shop, shopifyStaffId])
}

model Team {
  id        String       @id @default(cuid())
  shop      String
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]

  @@index([shop])
}

model TeamMember {
  teamId  String
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([teamId, staffId])
  @@index([staffId])
}

// One row per shop (created lazily; defaults apply when absent).
model ShopSetting {
  shop                 String   @id
  defaultPriceFloorPct Decimal  @default(15) @db.Decimal(5, 2)
  defaultTeamId        String?
  autoAssignByCompany  Boolean  @default(false)
  /// Quote alerts to sales are copied here; also the only recipient when a rep has no usable email.
  copyAllAlertsTo      String?
  updatedAt            DateTime @updatedAt
}

// Auto-assign new SUBMITTED quotes from a company (applied only when ShopSetting.autoAssignByCompany).
model RoutingRule {
  id        String  @id @default(cuid())
  shop      String
  companyId String // gid://shopify/Company/...
  repId     String?
  teamId    String?
  position  Int     @default(0)

  @@index([shop, companyId])
}

// shared = visible to every staff member (managed by managers); otherwise personal to `ownerId`.
model SavedReply {
  id        String   @id @default(cuid())
  shop      String
  ownerId   String?
  title     String
  body      String
  shared    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, shared])
  @@index([shop, ownerId])
}

// One row per outbound notification attempt (written by the worker; read for support and dedupe).
model NotificationLog {
  id         String   @id @default(cuid())
  quoteId    String? // null for non-quote mail such as the weekly summary
  channel    Channel
  to         String // email address or E.164 phone number
  status     String // e.g. SENT, FAILED, SKIPPED_QUIET_HOURS, SKIPPED_NO_OPT_IN
  providerId String? // Postmark MessageID / Twilio MessageSid
  createdAt  DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([to, createdAt])
}

// Extra people a rep added to ONE quote's customer-facing alerts. SMS entries stay PENDING until that person replies YES to the
// opt-in text (consent is theirs, never the rep's); STOP flips them to OPTED_OUT.
model QuoteRecipient {
  id                 String    @id @default(cuid())
  quoteId            String
  kind               String // EMAIL | SMS
  address            String // email address, or E.164 phone number
  name               String?
  state              String    @default("ACTIVE") // ACTIVE | PENDING | OPTED_OUT
  addedById          String?
  addedByName        String?
  optInRequestedAt   DateTime? // set by the worker once the opt-in text has gone out
  optInAt            DateTime?
  createdAt          DateTime  @default(now())

  @@unique([quoteId, kind, address])
  @@index([kind, address])
}

// Numbers that replied STOP (or were opted out another way). Never text a number listed here.
model SmsOptOut {
  phone  String   @id // E.164
  at     DateTime @default(now())
  source String // e.g. twilio-stop, admin, customer-prefs
}

// ---------------------------------------------------------------------------------------------------------------------
// Account pages (statement + account info), docs/ACCOUNT-PAGES.md. These tables are read and written with plain `pg`
// by packages/statement (never through the Prisma client); they are declared here only so schema.prisma, the migration
// and test/schema-sync.test.ts stay one description of the database. Model and field names equal the table and column
// names (snake_case) on purpose, so no @map is needed. The `kind`/`source` CHECK constraints live in the migration SQL.
// ---------------------------------------------------------------------------------------------------------------------

/// Shopify company -> Zoho customer. The tenant boundary for every account page.
model account_map {
  shopify_company_id String   @id
  zoho_customer_id   String   @unique
  customer_number    String   @unique
  display_name       String
  active             Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
}

/// Cached Zoho contact (balances, terms, credit limit).
model zoho_contact {
  zoho_customer_id       String   @id
  customer_number        String
  name                   String
  currency_code          String   @default("USD")
  payment_terms_label    String?
  credit_limit           Decimal? @db.Decimal(14, 2)
  outstanding_receivable Decimal  @default(0) @db.Decimal(14, 2)
  unused_credits         Decimal  @default(0) @db.Decimal(14, 2)
  raw                    Json     @default("{}")
  synced_at              DateTime @default(now()) @db.Timestamptz(6)
}

/// Cached Zoho invoices, payments, credit notes and sales orders.
model zoho_document {
  id               String    @id
  zoho_customer_id String
  kind             String
  number           String
  doc_date         DateTime  @db.Date
  due_date         DateTime? @db.Date
  status           String
  total            Decimal   @db.Decimal(14, 2)
  balance          Decimal   @default(0) @db.Decimal(14, 2)
  currency_code    String    @default("USD")
  reference        String?
  source           String    @default("zoho")
  raw              Json      @default("{}")
  synced_at        DateTime  @default(now()) @db.Timestamptz(6)

  // The migration creates this index with doc_date DESC; the sort order is left out here only because test/schema-sync.test.ts
  // derives the index name from the column list.
  @@index([zoho_customer_id, doc_date])
}

/// Single-use PDF download capabilities (token stored as a hash).
model pdf_link {
  token_hash       String    @id
  zoho_customer_id String
  doc_kind         String
  doc_id           String?
  expires_at       DateTime  @db.Timestamptz(6)
  used_at          DateTime? @db.Timestamptz(6)
}

/// One row per sync run per customer (status, counts, timing; never credentials).
model sync_event {
  id               BigInt   @id @default(autoincrement())
  zoho_customer_id String?
  kind             String
  detail           Json     @default("{}")
  created_at       DateTime @default(now()) @db.Timestamptz(6)
}

/// Who touched which account page and with what outcome (ok, denied, rate_limited, not_found, not_synced).
model access_audit {
  id                 BigInt   @id @default(autoincrement())
  shopify_company_id String?
  zoho_customer_id   String?
  action             String
  outcome            String
  created_at         DateTime @default(now()) @db.Timestamptz(6)
}
