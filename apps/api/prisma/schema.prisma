// Draft schema — backend agent owns this file after day 1.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  QUOTE_READY
  CHANGES_REQUESTED
  ACCEPTED
  ORDERED
  EXPIRED
  DECLINED
  ARCHIVED
}

enum AuthorType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum Channel {
  WEB
  EMAIL
  SMS
}

// Shopify session storage for the app template
model Session {
  id          String    @id
  shop        String
  state       String
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      BigInt?
}

model Job {
  id                String   @id @default(cuid())
  shop              String
  companyId         String   // gid://shopify/Company/...
  companyLocationId String?  // gid://shopify/CompanyLocation/...
  name              String
  poNumber          String?
  siteAddress       String?
  createdById       String   // gid://shopify/Customer/...
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  quotes            Quote[]

  @@index([shop, companyId])
}

model Quote {
  id                String      @id @default(cuid())
  shop              String
  number            Int         // displayed as Q-10482; unique per shop
  jobId             String?
  job               Job?        @relation(fields: [jobId], references: [id])
  title             String
  customerId        String      // owner (gid)
  companyId         String?
  companyLocationId String?
  assignedRepId     String?
  assignedRep       Staff?      @relation(fields: [assignedRepId], references: [id])
  teamId            String?
  status            QuoteStatus @default(DRAFT)
  currentVersion    Int         @default(0) // 0 = customer draft, 1..n = sent revisions
  notesToSales      String?
  neededBy          DateTime?
  shipToAddress     Json?
  expiresAt         DateTime?
  draftOrderId      String?     // set on ACCEPT → buy
  orderId           String?     // set by orders/create webhook
  watchers          Json        @default("[]") // extra people to notify
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  versions          QuoteVersion[]
  lines             QuoteLine[]
  messages          Message[]
  events            Event[]

  @@unique([shop, number])
  @@index([shop, companyId, status])
  @@index([shop, assignedRepId, status])
}

model QuoteVersion {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id])
  versionNo     Int
  sentById      String?
  sentAt        DateTime @default(now())
  subtotal      Decimal  @db.Decimal(12, 2)
  discountTotal Decimal  @db.Decimal(12, 2) @default(0)
  freight       Decimal  @db.Decimal(12, 2) @default(0)
  taxEstimate   Decimal? @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  repNote       String?  // customer-visible job notes
  internalNote  String?  // staff only
  lines         QuoteLine[]

  @@unique([quoteId, versionNo])
}

model QuoteLine {
  id          String        @id @default(cuid())
  quoteId     String
  quote       Quote         @relation(fields: [quoteId], references: [id])
  versionId   String?       // null = working draft lines
  version     QuoteVersion? @relation(fields: [versionId], references: [id])
  variantId   String        // gid://shopify/ProductVariant/...
  sku         String?
  title       String
  qty         Int
  listPrice   Decimal       @db.Decimal(12, 2) // dealer/catalog price snapshot
  quotedPrice Decimal       @db.Decimal(12, 2)
  cost        Decimal?      @db.Decimal(12, 2) // STAFF ONLY — never serialize to customers
  lineNote    String?
  addedBy     AuthorType    @default(CUSTOMER)
  position    Int
}

model Message {
  id          String     @id @default(cuid())
  quoteId     String
  quote       Quote      @relation(fields: [quoteId], references: [id])
  authorType  AuthorType
  authorId    String?
  body        String
  internal    Boolean    @default(false) // staff-only note
  attachments Json       @default("[]")  // [{url, name, size, mime}]
  channel     Channel    @default(WEB)
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([quoteId, createdAt])
}

model NotificationPref {
  id         String   @id @default(cuid())
  shop       String
  customerId String?
  staffId    String?
  event      String   // e.g. QUOTE_READY, NEW_MESSAGE, EXPIRING
  email      Boolean  @default(true)
  sms        Boolean  @default(false)
  phone      String?
  smsOptInAt DateTime?
  quietStart String?  // "19:00"
  quietEnd   String?  // "07:00"
  timezone   String   @default("America/New_York")

  @@unique([shop, customerId, staffId, event])
}

model Event {
  id        String    @id @default(cuid())
  quoteId   String
  quote     Quote     @relation(fields: [quoteId], references: [id])
  type      String    // QuoteEvent or NEW_MESSAGE
  actorType AuthorType
  actorId   String?
  payload   Json      @default("{}")
  notifiedAt DateTime? // set by worker once fanned out
  createdAt DateTime  @default(now())

  @@index([notifiedAt, createdAt])
}

model Staff {
  id             String  @id @default(cuid())
  shop           String
  shopifyStaffId String?
  name           String
  email          String
  phone          String?
  teamId         String?
  priceFloorPct  Decimal @db.Decimal(5, 2) @default(15)
  isManager      Boolean @default(false)
  quotes         Quote[]
}
